# Aska Dedicated Server Configuration
# Copy this file to .env and fill in your values

# Required: Steam authentication token for AppId 1898300
# Get yours at: https://steamcommunity.com/dev/managegameservers
AUTHENTICATION_TOKEN=your_steam_token_here

# Server display name (shown in left column of server list)
SESSION_NAME=My Aska Server

# Server host name (shown in right column of server list)
SERVER_NAME=Aska Server

# Server region (leave 'default' for automatic best ping)
# Options: default, europe, asia, us-east, us-west, australia, etc.
REGION=default

# Server password (leave empty for public server)
PASSWORD=

# UDP port for gameplay (clients connect here)
SERVER_PORT=27015

# UDP port for server browser queries
SERVER_QUERY_PORT=27016

# Keep world alive when no players connected
# true = world updates without players, false = loads only when players join
KEEP_WORLD_ALIVE=false

# Autosave frequency
# Options: disabled, every morning, every 5 minutes, every 10 minutes, every 15 minutes, every 20 minutes
AUTOSAVE_STYLE=every morning

# Override savegame ID (leave empty for default behavior)
# Use this to prevent savegame recreation on restart
SAVE_ID=

# Skip Steam file integrity validation on startup (faster startup)
NO_VALIDATE=false
